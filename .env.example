# Slack bot (existing) — posting + Socket Mode for approval interactions
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-level-token

# Sign in with Slack (OAuth / OIDC)
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret

# Session cookie signing — generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Approval channels (names with # or channel IDs)
SLACK_APPROVAL_CHANNEL=#banner-approvals
SLACK_APPROVED_CHANNEL=#approved-designs

# Server
PORT=3000
# Public origin (used for OAuth redirect + Slack image previews).
# On Railway this is auto-derived from RAILWAY_PUBLIC_DOMAIN.
PUBLIC_BASE_URL=https://your-domain.example

APPROVER_NAME=Max
