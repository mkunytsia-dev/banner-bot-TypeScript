{
  "name": "banner-bot",
  "version": "1.0.0",
  "description": "Slack bot for automated banner generation from Figma-based templates",
  "main": "src/app.ts",
  "scripts": {
    "start": "tsx src/app.ts",
    "dev": "tsx watch src/app.ts",
    "preview": "tsx src/generate-previews.ts",
    "web": "tsx src/web-server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@slack/bolt": "^4.1.0",
    "dotenv": "^16.4.0",
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
